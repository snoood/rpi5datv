(symbol (lib_id "power:GND") (at 121.92 81.28 0) (unit 1) (exclude_from_sim no) (in_bom no) (on_board yes) (dnp no) (uuid "431fb45c-7136-488e-b8cf-68a56777e2fa")
  (property "Reference" "#PWR05" (at 124.46000000000001 80.01 0) (effects (font (size 1.27 1.27)) hide))
